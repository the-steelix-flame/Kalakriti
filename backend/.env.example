# ===========================================================================
#  Kalakriti - backend configuration
#
#  Every variable the backend reads is listed below, in the order somebody
#  setting this up needs them. Copy this file to `.env` and paste your keys
#  next to the `=`. Nothing here needs to be looked up in the source.
#
#  Two rules that are easy to get wrong:
#
#  1. A blank value is NOT the same as an absent one. `load_dotenv` puts an
#     empty string into the environment, and an empty string overrides the
#     built-in default. That is harmless for a credential, but for a number
#     or a URL it either breaks the feature or crashes the process at import.
#     So: credentials are left blank below, and the tuning variables in the
#     last section already carry their working defaults. Leave those alone
#     unless you mean to change them, and delete the whole line rather than
#     blanking it if you want the built-in default back.
#
#  2. Nothing here is faked. An unconfigured marketplace or courier reports
#     `not_configured` and names the exact variables it is missing. It never
#     reports a success it did not have.
#
#  This file is the template and is committed. `.env` holds the real values
#  and is gitignored - keep it that way.
# ===========================================================================


# ===========================================================================
#  1. REQUIRED TO RUN AT ALL
# ===========================================================================

# The single key the app cannot start useful work without. It powers the
# language model (listing copy, translation, pricing rationale) and the
# vision model (reading a photograph of the craft).
#
# Where: sign in at https://build.nvidia.com, open any model page, and use
# the "Get API Key" button on that page. The key it issues starts with
# `nvapi-` and works for every model in the catalogue, so you only need one.
#
# REQUIRED. Without it, uploads still store and the storefront still serves,
# but every generated field comes back empty and the app is not doing its job.
NVIDIA_API_KEY=

# Development-only OTP delivery escape hatch. Set to `true` and the login
# code is returned in the API response and displayed in the app behind a
# visible "SMS not configured" warning.
#
# NEVER SET THIS IN PRODUCTION. Anyone who can reach the API can then read
# the code for any phone number and sign in as that person.
#
# It does not weaken the verification itself. The code is still six random
# digits, stored only as a salted SHA-256 hash, expiring in 5 minutes, with
# a capped number of verify attempts and a resend cooldown. All this changes
# is that the code has no way to reach a handset when no SMS provider is
# configured, so it is handed back over the same channel instead.
#
# OPTIONAL. Leave blank in production and configure a real SMS provider in
# section 5 instead. Blank means: no provider, no echo, no login.
OTP_DEV_ECHO=


# ===========================================================================
#  2. ONLINE DATABASE
# ===========================================================================

# Where artisans, listings, orders, shipments, sessions and the event log
# live.
#
# The line below holds the local SQLite default. Replace the whole value with
# your hosted Postgres URL when you have one. Do not simply blank it: an empty
# string is not the same as an unset variable, and db.py cannot build an
# engine from "" - the process refuses to start.
#
# SQLite is a real database and completely fine on a laptop. On a hosted
# container it is a trap: every free tier
# (Render, Railway, Fly) gives the container an ephemeral filesystem that is
# wiped on each redeploy and most restarts, so every account and every order
# silently disappears the next time you deploy. The app detects this case and
# surfaces a warning on /health, but the data is already gone by then.
#
# Free hosted Postgres, all sufficient for this app:
#   Neon     - https://neon.tech, 0.5 GB, scales to zero when idle, no expiry
#   Supabase - https://supabase.com, 500 MB, no expiry
#   Render   - https://render.com, 1 GB, but the free instance EXPIRES after
#              30 days and the data goes with it. Fine for a demo, not for a
#              pilot with real artisans on it.
#
# Where to copy it from:
#   Neon     - console.neon.tech, open your project, the Connection Details
#              panel on the dashboard shows the connection string.
#   Supabase - your project's Settings, Database section, "Connection string".
#              Substitute the database password you chose at project creation
#              for the placeholder it prints.
#
# The canonical shape, driver prefix included:
#   postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# Providers almost always print a URL beginning `postgres://` or
# `postgresql://` instead. Paste it as-is - db.py rewrites either of those to
# `postgresql+psycopg://` on startup, because SQLAlchemy 2.x dropped the
# `postgres://` alias and defaults the rest to psycopg2, which this project
# does not install. An explicit driver you chose yourself is left alone.
#
# Keep `?sslmode=require` - hosted Postgres refuses unencrypted connections.
#
# If the password contains @ : / or ?, percent-encode it (@ becomes %40).
#
# RECOMMENDED for anything hosted. OPTIONAL on a laptop.
# ---------------------------------------------------------------------------
# SUPABASE: paste your string on the SUPABASE line below, then comment out the
# sqlite line under it. Nothing else in the project changes.
#
# Take the string from: Supabase dashboard -> Connect (top bar) -> ORMs / URI.
#
# TAKE THE **SESSION POOLER** STRING, NOT THE DIRECT ONE. This is the part that
# costs an afternoon, so it is worth being precise about:
#
#   Direct connection   db.<ref>.supabase.co:5432
#                       Resolves to IPv6 only. Most home broadband, most office
#                       wifi and most CI runners have no IPv6 route, so this
#                       fails with a connection timeout that looks exactly like
#                       a wrong password or a firewall. It is neither.
#
#   Session pooler      aws-0-<region>.pooler.supabase.com:5432   <- USE THIS
#                       IPv4, and it holds one Postgres connection per client
#                       session, which is what SQLAlchemy's own pool expects.
#
#   Transaction pooler  aws-0-<region>.pooler.supabase.com:6543
#                       IPv4 too, but it hands a different backend to every
#                       transaction, so server-side prepared statements break.
#                       Usable only with ?prepare_threshold=0 on psycopg. There
#                       is no reason to take that on here.
#
# The username in a pooler string is postgres.<project-ref>, with the dot. That
# is correct and not a typo - it is how the pooler knows which project you want.
#
# Percent-encode the password if it contains @ : / or ? (@ becomes %40).
#
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Then set DATABASE_URL to that same value and comment out the sqlite line:
# DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ---------------------------------------------------------------------------

DATABASE_URL=sqlite:///./kalakriti.db


# ===========================================================================
#  3. IMAGE STORAGE
# ===========================================================================

# Where product photographs are written.
#
# Blank means local disk, served by this process. Correct on a laptop, wrong
# on a host, and for the same reason as the database above: the container's
# filesystem is wiped on redeploy. A listing whose image 404s after a deploy
# is worse than one with no image, because the marketplace has already
# published the dead link to buyers.
#
# Any S3-compatible store works. Free options that are genuinely free:
#   Cloudflare R2    - 10 GB, no egress charges. The usual choice.
#   Supabase Storage - 1 GB on the free project, same S3 API.
#   Backblaze B2     - 10 GB.
#
# Cloudflare R2 setup: dash.cloudflare.com, R2 in the sidebar, create a
# bucket, then use the R2 API-token screen to create a token with object read
# and write permission. That screen gives you the access key id, the secret
# access key, and the S3 API endpoint for your account.
#
# All four of ENDPOINT, BUCKET, KEY and SECRET must be set together. Set some
# but not all and the module logs exactly which are missing once at startup
# and falls back to disk, rather than failing on the first photograph.
#
# RECOMMENDED for anything hosted. OPTIONAL on a laptop.

# S3 API endpoint, e.g. https://ACCOUNT-ID.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_KEY=
MEDIA_S3_SECRET=

# Region. R2 wants the literal string `auto`. Real AWS wants a region name
# such as `ap-south-1`. Do not leave this blank.
MEDIA_S3_REGION=auto

# The bucket's public read URL, e.g. https://media.example.com or the r2.dev
# subdomain Cloudflare gives you when you enable public access. Image URLs
# handed to marketplaces are built from this. Without it the uploads succeed
# but the links point nowhere a buyer can reach.
MEDIA_PUBLIC_BASE=


# ===========================================================================
#  4. PUBLIC ADDRESS AND SECRETS
# ===========================================================================

# The address buyers and marketplaces will use to reach this backend. Every
# storefront listing URL, payment webhook target and courier callback URL is
# built from it.
#
# `http://localhost:8000` is right while you are on one machine. It is wrong
# the moment anything outside the machine has to reach you - a phone on
# another network, a Razorpay webhook, an ONDC gateway. For a demo, run
# `ngrok http 8000` or a Cloudflare tunnel and paste the https URL it prints.
# When deployed, this is the service's own public URL.
#
# No trailing slash.
#
# REQUIRED in any setup where something other than this machine has to reach
# the backend. A wrong value means listing links and webhooks quietly point
# at an address nobody can resolve.
PUBLIC_BASE_URL=http://localhost:8000

# Signing key for login session tokens.
#
# Leave blank and the app generates a strong random key on first start and
# saves it to `jwt_secret.txt` (see JWT_SECRET_FILE), so a restart does not
# log everybody out. That is the right behaviour on a laptop.
#
# Set it explicitly when running on a host with an ephemeral filesystem, or
# across more than one instance - otherwise each instance invents its own key
# and sessions issued by one are rejected by the others.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# RECOMMENDED when hosted. OPTIONAL locally. Changing it logs everybody out.
JWT_SECRET=

# Salt for the hash that de-duplicates storefront page views, so view counts
# are per-visitor-per-hour rather than per-refresh. It is hashed together
# with the visitor IP and user agent and never stored in reversible form.
#
# Blank derives it from JWT_SECRET, which is fine. Set it only if you want
# view counting to stay stable across a JWT_SECRET rotation.
#
# OPTIONAL. Without it, nothing breaks.
VIEW_SALT=


# ===========================================================================
#  5. SMS / OTP DELIVERY
# ===========================================================================
#
# How the login code reaches the artisan's phone.
#
# To be clear about what these do and do not control: the OTP is always real
# regardless of what is set here. Six random digits, stored only as a salted
# SHA-256 hash, 5-minute expiry, limited verify attempts, resend cooldown.
# These variables configure DELIVERY only. With none of them set, no SMS is
# sent and nobody can log in unless OTP_DEV_ECHO is on for development.
#
# Configure ONE of Fast2SMS, MSG91 or Twilio. If more than one is set, the
# order of preference is MSG91, then Fast2SMS, then Twilio.

# Fast2SMS - the one that can be working within the hour, and therefore the
# right choice while the DLT template for MSG91 is still in approval.
#
# Its OTP route sends under Fast2SMS's OWN DLT-approved template, which is why
# no registration is needed at our end. The trade-off is that the wording and
# the sender id belong to them: the artisan receives "Your OTP: 123456" from a
# Fast2SMS sender, not from Kalakriti. Fine for testing and for a demo; move to
# MSG91 before this is in real artisans' hands.
#
# The code itself is still ours - we generate it, hash it, and verify against
# our own hash. The provider only carries it.
#
# Where: sign up at https://www.fast2sms.com, then Dev API -> API key. Signup
# needs a phone number and an email, nothing else, and new accounts come with
# a small amount of free credit which is plenty for testing a login.
#
# FASTEST PATH. Without it, Fast2SMS is skipped.
FAST2SMS_API_KEY=

# MSG91 - the usual choice for Indian numbers, and the cheaper one. Indian
# regulation (TRAI DLT) requires transactional SMS to use a pre-registered
# template, so you need both the auth key and the approved template id.
#
# Where: sign up at https://msg91.com. The auth key is on the API keys page
# of the MSG91 panel. The template id comes from the OTP template you create
# and submit for DLT approval - approval is not instant, so start it early if
# you need SMS working to a deadline.
#
# RECOMMENDED for production in India. Without both, MSG91 is skipped.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Twilio - works everywhere, no DLT paperwork, but sending to Indian numbers
# from a Twilio number has its own registration requirements and costs more.
# Useful for testing from outside India.
#
# Where: https://www.twilio.com. The Account SID and Auth Token are on the
# console dashboard. The from-number is a number you have bought or verified
# in the console's phone-numbers section, in E.164 form (e.g. +15551234567).
#
# OPTIONAL. All three are needed together; without them Twilio is skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ===========================================================================
#  6. PAYMENTS
# ===========================================================================

# UPI needs no API and no account anywhere - just the artisan's own UPI
# address. Orders then get a real `upi://pay` intent link that opens any UPI
# app with the payee and amount already filled in. Money goes directly to the
# artisan; nothing sits in the middle.
#
# The VPA is the handle the artisan already has, e.g. name@oksbi, or a phone
# number followed by @ybl. The name is what the payer sees in their UPI app.
#
# RECOMMENDED - it is the lowest-friction thing here. Without it, and without
# Razorpay, an order is created but has no way to be paid.
ARTISAN_UPI_VPA=
ARTISAN_UPI_NAME=

# Razorpay - creates a real payment order and verifies the webhook signature
# with HMAC before believing anything it says. Test-mode keys work end to
# end, so you can exercise the whole paid-to-shipped flow without real money.
#
# Where: https://dashboard.razorpay.com. Key id and key secret come from
# Settings, API Keys - generate a key and copy the secret immediately, as it
# is shown only once. The webhook secret is one you choose yourself when you
# add a webhook under Settings, Webhooks.
#
# Point that webhook at:  PUBLIC_BASE_URL + /webhooks/razorpay
# and subscribe it to:    payment.captured, payment.failed, refund.processed
#
# OPTIONAL. Without the key pair, orders fall back to the UPI link above.
# Without the webhook secret, incoming webhooks are rejected rather than
# trusted, so payments will never be confirmed automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ===========================================================================
#  7. MARKETPLACES
# ===========================================================================
#
# "My Storefront" always works and needs no configuration. Everything below
# is an additional real publishing target. Each one reports `not_configured`
# and lists its missing variables until it has all of them.

# --- ONDC ------------------------------------------------------------------
# The open network. Zero commission, but the highest barrier: you have to be
# a registered ONDC network participant. That means applying via
# https://ondc.org, generating an Ed25519 signing key pair, publishing the
# public half on the ONDC registry, and being issued a subscriber id and a
# gateway URL. The adapter signs every request per the ONDC auth spec and
# posts a genuine Beckn on_search catalogue.
#
# ONDC_SIGNING_PRIVATE_KEY is the base64 private half of that Ed25519 pair.
# ONDC_UNIQUE_KEY_ID matches the key id you registered it under; `1` is the
# conventional first one.
#
# OPTIONAL. Needs SUBSCRIBER_ID, SIGNING_PRIVATE_KEY and GATEWAY_URL before
# it will attempt anything.
ONDC_SUBSCRIBER_ID=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_GATEWAY_URL=
ONDC_UNIQUE_KEY_ID=1
# Seller name shown in the ONDC catalogue.
ONDC_STORE_NAME=Kalakriti

# --- GeM (Government e-Marketplace) ----------------------------------------
# API access is issued only to sellers already registered on GeM, and the
# base URL is issued together with the credentials rather than being public.
# Register at https://gem.gov.in and request API access from the integration
# section of the seller dashboard.
#
# OPTIONAL. Needs all three.
GEM_API_KEY=
GEM_SELLER_ID=
GEM_API_BASE=

# --- Amazon SP-API ---------------------------------------------------------
# Publishes a real listing via putListingsItem. Requires a Professional
# selling account, a registered Login-with-Amazon application, and a refresh
# token obtained by authorising that application against the seller account.
#
# Where: https://sellercentral.amazon.in, the Apps and Services section,
# Develop Apps - that is where the LWA client id and client secret live, and
# where you self-authorise the app to get a refresh token. The seller id
# (merchant token) is under Settings, Account Info.
#
# OPTIONAL. Needs CLIENT_ID, CLIENT_SECRET, REFRESH_TOKEN and SELLER_ID.
AMZN_LWA_CLIENT_ID=
AMZN_LWA_CLIENT_SECRET=
AMZN_REFRESH_TOKEN=
AMZN_SELLER_ID=
# Marketplace and endpoint. The defaults are amazon.in and the EU-region
# endpoint that serves India. Change only if you are selling elsewhere.
AMZN_MARKETPLACE_ID=A21TJRUUN4KGV
AMZN_SP_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
# Amazon product type for the listing. `PRODUCT` is the generic fallback; a
# specific type from Amazon's product type definitions categorises better.
AMZN_PRODUCT_TYPE=PRODUCT
# How far back to look when pulling order statistics. ISO 8601, UTC.
AMZN_ORDERS_SINCE=2024-01-01T00:00:00Z

# --- Shopify ---------------------------------------------------------------
# The fastest real third-party storefront to get working: a free Shopify
# development store issues an Admin API access token immediately, with no
# onboarding queue or approval wait. Good for proving the publish path end to
# end before the slower marketplaces come through.
#
# Where: create a development store from a Shopify Partners account at
# https://partners.shopify.com, then in that store's admin go to Settings,
# Apps and sales channels, Develop apps - create an app, grant it write
# access to products, and install it. Installing reveals the Admin API access
# token, which begins `shpat_`.
#
# SHOPIFY_STORE is the myshopify hostname only, e.g. my-store.myshopify.com
# with no https:// and no trailing slash.
#
# OPTIONAL. Needs STORE and ACCESS_TOKEN.
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
# Admin API version. Pinned deliberately - Shopify retires old versions on a
# schedule, so this needs bumping roughly yearly.
SHOPIFY_API_VERSION=2025-01
# Set to any non-empty value to also pull order counts from Shopify when
# collecting listing statistics. Requires the app to hold the read_orders
# scope, which Shopify grants only on request. Blank means order stats are
# reported as unavailable rather than guessed.
SHOPIFY_READ_ORDERS=


# ===========================================================================
#  8. LOGISTICS
# ===========================================================================
#
# When configured, a confirmed payment books a real consignment and returns a
# real AWB number the buyer can track. Configure ONE of the two.

# Shiprocket - an aggregator, no volume commitment, easiest to start with.
# Where: https://app.shiprocket.in. Use your account login email and
# password. The pickup nickname is the name you gave the pickup address you
# added under Settings, Pickup Addresses - it must match exactly, and on a
# new account it is usually `Primary`.
#
# OPTIONAL. Needs email and password together.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_NICKNAME=Primary

# Delhivery - direct courier integration, better rates at volume, requires a
# business account. Where: https://www.delhivery.com - request API access
# through the client portal or your account manager; they issue the API token
# and register the pickup location against your account. The pickup name must
# match that registered warehouse name exactly.
#
# OPTIONAL. Needs the API token; the pickup name is required for real
# bookings to be accepted.
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_NAME=
# Production base URL. Delhivery's staging environment is a different host,
# so change this only when testing against staging.
DELHIVERY_BASE=https://track.delhivery.com

# Shared secret for courier status callbacks posted to
#   PUBLIC_BASE_URL + /webhooks/logistics/{provider}
# You choose this string yourself and give the same value to the courier when
# you register the webhook.
#
# RECOMMENDED. Blank means callbacks are rejected rather than trusted, so
# tracking status will not update itself. That is the safe failure: an
# unauthenticated endpoint would let anyone mark any order delivered.
LOGISTICS_WEBHOOK_SECRET=

# Book the courier automatically the moment a payment webhook confirms
# payment. Set to `false` to require someone to press ship manually - useful
# while testing, so a test payment does not create a real consignment.
AUTO_SHIP_ON_PAYMENT=true


# ===========================================================================
#  9. TUNING AND OPTIONAL
# ===========================================================================
#
# These already hold their built-in defaults. They are listed so you can see
# what exists and change it deliberately. Do not blank them out - an empty
# value overrides the default, and the numeric ones will crash the process at
# startup if they are empty. Delete the line instead.

# --- Models ----------------------------------------------------------------
# Reasoning model for listing copy, translation and pricing.
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Vision model that reads the uploaded photograph.
NVIDIA_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA's OpenAI-compatible endpoint. Change only to point at a self-hosted
# NIM container.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Vision fields below this confidence are shown to the artisan as suggestions
# to confirm, never silently auto-filled. Lower means more auto-fill and more
# wrong guesses reaching a marketplace. Range 0 to 1.
VISION_CONFIDENCE_FLOOR=0.55
# Hosted diffusion endpoint for generated product backdrops. NVIDIA does not
# enable this on every account; when it is unreachable the local `studio`
# generator is used instead, which needs no key and no network.
FLUX_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-schnell

# --- Database connection ---------------------------------------------------
# How long a connection attempt may hang before it is abandoned, in seconds.
# Without a cap, a wrong host makes the TCP connect wait out the operating
# system default - about two minutes on Linux - so the container looks hung at
# startup and the platform kills it before any error reaches the log.
# Only applies to Postgres.
DB_CONNECT_TIMEOUT=10
# The name this app reports to Postgres, visible in pg_stat_activity. Worth
# changing only if several services share one database and you need to tell
# their connections apart when the pool fills up.
APP_NAME=kalakriti

# --- Local paths -----------------------------------------------------------
# Directory for locally stored images, relative to the backend directory.
# Only used when MEDIA_S3_* is not configured.
MEDIA_DIR=media
# Where the auto-generated JWT signing key is cached, so restarts do not log
# everybody out. Ignored when JWT_SECRET is set explicitly.
JWT_SECRET_FILE=jwt_secret.txt
# Ed25519 key used to sign craft passports. Generated on first use if absent.
PASSPORT_KEY_PATH=passport_key.pem

# --- Session and OTP timings -----------------------------------------------
# How long a login lasts before the artisan has to verify again.
SESSION_DAYS=60
# How long an issued OTP stays valid, in seconds.
OTP_TTL_SECONDS=300
# Minimum gap between resend requests, in seconds. This is rate limiting, not
# cosmetics - lowering it makes OTP brute force cheaper.
OTP_RESEND_COOLDOWN=45


# ===========================================================================
#  Set by the host, not by you
# ===========================================================================
#
# The backend also reads RENDER, FLY_APP_NAME and RAILWAY_ENVIRONMENT. You do
# not set these - the platform sets them itself. Their only use is to detect
# that the process is running on an ephemeral container, so /health can warn
# that SQLite and local image storage will lose data on the next deploy.
# Setting them by hand on a laptop would only produce a false warning.
