# ═══════════════════════════════════════════════════════════════════════════
#  ShilpIchiba configuration
#
#  Only the first block is needed to run everything that works locally:
#  OCR, object detection, matting, background generation, copy, pricing,
#  the storefront, real orders and the full order lifecycle.
#
#  Every block below that enables one more real marketplace or payment
#  integration. Until its variables are set, that channel reports
#  `not_configured` and names exactly what is missing - it never fakes success.
# ═══════════════════════════════════════════════════════════════════════════

# ── Required: language + vision ────────────────────────────────────────────
# Free key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Fields below this confidence are shown as suggestions, never auto-filled.
VISION_CONFIDENCE_FLOOR=0.55

# ── Server ─────────────────────────────────────────────────────────────────
# Must be reachable by buyers for storefront listing URLs to work off-machine.
# Use an ngrok/Cloudflare tunnel URL for a public demo.
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./shilpichiba.db
MEDIA_DIR=media
PASSPORT_KEY_PATH=passport_key.pem

# ── Authentication / OTP ───────────────────────────────────────────────────
# The OTP itself is always real: six random digits, stored only as a salted
# SHA-256 hash, 5-minute expiry, 5 verify attempts, 45s resend cooldown.
# What these configure is DELIVERY. With none set, no SMS is sent.
#
# MSG91 is the usual Indian choice (DLT-registered templates):
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Or Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
#
# Local development only: with no SMS provider, this returns the code in the API
# response and shows it in the UI behind a loud "SMS not configured" warning.
# It does NOT weaken verification - the code must still match. Never enable in
# production.
OTP_DEV_ECHO=false

JWT_SECRET=
JWT_SECRET_FILE=jwt_secret.txt
SESSION_DAYS=60
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN=45

# ── Shipping / logistics (optional) ────────────────────────────────────────
# Books a real consignment when payment is confirmed, and returns a real AWB.
# Shiprocket: an account plus a saved pickup location nickname.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_NICKNAME=Primary
# Or Delhivery: an API token and a registered pickup-location name.
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_NAME=
DELHIVERY_BASE=https://track.delhivery.com
# Shared secret for POST <PUBLIC_BASE_URL>/webhooks/logistics/{provider}.
# Unset means courier callbacks are rejected rather than trusted.
LOGISTICS_WEBHOOK_SECRET=
# Book the courier automatically the moment a payment webhook confirms payment.
AUTO_SHIP_ON_PAYMENT=true

# ── Payments (optional) ────────────────────────────────────────────────────
# UPI needs no API at all - just the artisan's VPA. Orders get a real UPI
# intent link that opens any UPI app with the amount pre-filled.
ARTISAN_UPI_VPA=
ARTISAN_UPI_NAME=

# Razorpay: real order creation + HMAC-verified webhook at /webhooks/razorpay.
# Test-mode keys work end to end. Point the dashboard webhook at
#   <PUBLIC_BASE_URL>/webhooks/razorpay
# and subscribe to payment.captured, payment.failed, refund.processed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── ONDC (optional) ────────────────────────────────────────────────────────
# Requires registration as an ONDC network participant: a subscriber id, an
# Ed25519 signing key pair published on the ONDC registry, and a gateway URL.
# The adapter signs requests per the ONDC auth spec and posts a real Beckn
# on_search catalogue.
ONDC_SUBSCRIBER_ID=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_UNIQUE_KEY_ID=1
ONDC_GATEWAY_URL=
ONDC_STORE_NAME=ShilpIchiba

# ── Amazon SP-API (optional) ───────────────────────────────────────────────
# Requires a Professional selling account, an LWA application and a refresh
# token. Calls putListingsItem for real.
AMZN_LWA_CLIENT_ID=
AMZN_LWA_CLIENT_SECRET=
AMZN_REFRESH_TOKEN=
AMZN_SELLER_ID=
AMZN_MARKETPLACE_ID=A21TJRUUN4KGV
AMZN_SP_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMZN_PRODUCT_TYPE=PRODUCT

# ── GeM (optional) ─────────────────────────────────────────────────────────
# GeM issues API access only to registered sellers; base URL is issued with it.
GEM_API_KEY=
GEM_SELLER_ID=
GEM_API_BASE=

# ── Shopify (optional) ─────────────────────────────────────────────────────
# The fastest real third-party storefront to enable: a free development store
# issues an Admin API access token immediately, with no onboarding queue.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# ── Image generation (optional) ────────────────────────────────────────────
# NVIDIA's hosted diffusion endpoints are not enabled on every account; the
# local `studio` generator is used when this is unreachable.
FLUX_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-schnell
