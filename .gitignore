.expo/
dist/
web-build/
*.apk
*.aab
build/
.gradle/

# ── runtime data ───────────────────────────────────────────────────────────
backend/*.db
backend/media/
*.log

# ── editor / OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

